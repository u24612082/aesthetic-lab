# Run scripts/bootstrap.py to generate a secret .env (never commit it).
APP_TOKEN=replace-with-at-least-32-random-characters
APP_DB=var/aesthetic.sqlite3
APP_TIMEZONE=Africa/Johannesburg
APP_TRACKER_MODE=native
# Explicit interface IPs only. Never 0.0.0.0. Add your Mac's reserved LAN IP.
APP_BIND=127.0.0.1
APP_PORT=8765
APP_HOSTS=localhost,127.0.0.1
# Required for non-loopback listeners. iPhone must trust the issuing CA.
APP_TLS_CERT=
APP_TLS_KEY=
# Optional JSON inbox (iCloud Drive is OK here, never for APP_DB).
APP_INBOX=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AUTO_COACH=false
COACH_INTERVAL_SECONDS=1800

# Use your own Claude Code subscription through local MCP, without API billing.
COACH_PROVIDER=subscription

# Run the installed, subscription-signed-in client in the background after saved changes.
CLAUDE_AUTO_COACH=true

# Optional second HTTPS listener, prepared by Setup iPhone Access.command.
# Desktop HTTP stays on 127.0.0.1; no wildcard/public bind is used.
APP_PHONE_INTERFACE=
APP_PHONE_HOST=
APP_PHONE_PORT=8443
APP_PHONE_TLS_CERT=
APP_PHONE_TLS_KEY=
